# ================================
# MongoDB Configuration (Existing)
# ================================
# Using existing arken_process_db with authentication
MONGODB_URL=mongodb://arken_app:arken_app_password@localhost:27017/arken_process_db?authSource=admin
MONGODB_DB_NAME=arken_process_db

# ================================
# Redis Configuration (New)
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_EVENT_TTL=3600

# ================================
# Anthropic API (LLM Provider)
# ================================
# Get your API key from: https://console.anthropic.com/
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=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
GOOGLE_API_KEY=AIzaSyDFTUsqB78AZbBwIvwreI0OMskz6hK_POI

# ================================
# MCP Server Configuration
# ================================
# Match Claude Desktop configuration exactly
MCP_SERVER_COMMAND=/Users/akashnikam/workspace/mcp_process_server/venv/bin/python
MCP_SERVER_ARGS=/Users/akashnikam/workspace/mcp_process_server/server.py
MCP_SERVER_ENV_CALC_ENGINE_URL=http://localhost:8000
MCP_SERVER_ENV_MAX_STORED_RUNS=1000
MCP_SERVER_ENV_MONGODB_URI=mongodb://arken_app:arken_app_password@localhost:27017/arken_process_db?authSource=admin

# ================================
# API Configuration
# ================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=true

# ================================
# Worker Configuration (RQ)
# ================================
RQ_QUEUE_NAME=default
RQ_WORKER_COUNT=1
RQ_JOB_TIMEOUT=300

# ================================
# Report Generation Settings
# ================================
# Directory for storing generated PDF reports
REPORT_STORAGE_PATH=storage/reports

# Maximum streams per table before splitting (5-20 recommended)
REPORT_MAX_STREAMS_PER_TABLE=10

# Anthropic model for AI narrative generation
REPORT_LLM_MODEL=claude-sonnet-4-20250514

# Max tokens for AI-generated sections (500-4000 recommended)
REPORT_LLM_MAX_TOKENS=1500

# PDF page size: 'letter' or 'A4'
REPORT_PDF_PAGE_SIZE=letter


# ================================
# Application Settings
# ================================
LOG_LEVEL=INFO
ENVIRONMENT=development# ================================
