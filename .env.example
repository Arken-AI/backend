# ================================
# MongoDB Configuration
# ================================
MONGODB_URL=mongodb://arken_app:your_password_here@localhost:27017/arken_process_db?authSource=admin
MONGODB_DB_NAME=arken_process_db

# ================================
# Redis Configuration
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here
REDIS_EVENT_TTL=3600

# ================================
# LLM Provider Configuration
# ================================
DEFAULT_LLM_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ================================
# MCP Server Configuration (SSE Transport)
# ================================
# MCP Process Server (Sugar Industry) - SSE on port 8080
MCP_SERVER_URL=http://localhost:8080/sse
MCP_PROCESS_SERVER_ENABLED=true

# MCP Calculation Engine Server (Dynamic Flowsheets) - SSE on port 8082
MCP_CALC_ENGINE_SERVER_URL=http://localhost:8082/sse
MCP_CALC_ENGINE_ENABLED=true

# ================================
# API Configuration
# ================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8001
API_DEBUG=true
FRONTEND_URL=http://localhost:5173

# ================================
# Worker Configuration (RQ)
# ================================
RQ_QUEUE_NAME=default
RQ_WORKER_COUNT=1
RQ_JOB_TIMEOUT=300

# ================================
# Report Generation Settings
# ================================
REPORT_STORAGE_PATH=storage/reports
REPORT_MAX_STREAMS_PER_TABLE=10
REPORT_LLM_MODEL=claude-sonnet-4-20250514
REPORT_LLM_MAX_TOKENS=1500
REPORT_PDF_PAGE_SIZE=letter

# ================================
# Application Settings
# ================================
LOG_LEVEL=INFO
ENVIRONMENT=development
