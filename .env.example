# ================================
# MongoDB Configuration (Existing)
# ================================
# Using existing arken_process_db with authentication
MONGODB_URL=mongodb://arken_app:your_password@localhost:27017/arken_process_db?authSource=admin
MONGODB_DB_NAME=arken_process_db

# ================================
# Redis Configuration (New)
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_password
REDIS_EVENT_TTL=3600  # 1 hour in seconds (for SSE event streams)

# ================================
# Anthropic API (LLM Provider)
# ================================
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=your_password
GOOGLE_API_KEY==your_google_api_key_here

# ================================
# MCP Server Configuration
# ================================
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,mcp_process_server.server
MCP_SERVER_CWD=/Users/akashnikam/arken/calculation_engine

# ================================
# MCP Calculation Engine Server Configuration
# ================================
# Enable/disable the calculation engine server
MCP_CALC_ENGINE_ENABLED=true

# Command to start the server (python interpreter path)
MCP_CALC_ENGINE_COMMAND=python

# Arguments to pass (usually server.py)
MCP_CALC_ENGINE_ARGS=server.py

# Working directory where the server code is located
MCP_CALC_ENGINE_CWD=/path/to/mcp_calculation_engine_server

# Calculation engine API URL (same as process server by default)
MCP_CALC_ENGINE_ENV_CALC_ENGINE_URL=http://localhost:8000

# MongoDB URI (leave empty to use MONGODB_URL)
MCP_CALC_ENGINE_ENV_MONGODB_URI=

# ================================
# API Configuration
# ================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ================================
# Worker Configuration (RQ)
# ================================
RQ_QUEUE_NAME=default
RQ_WORKER_COUNT=1
RQ_JOB_TIMEOUT=300  # 5 minutes max per job

# ================================
# Report Generation Settings
# ================================
# Directory for storing generated PDF reports
REPORT_STORAGE_PATH=storage/reports

# Maximum streams per table before splitting (5-20 recommended)
REPORT_MAX_STREAMS_PER_TABLE=10

# Anthropic model for AI narrative generation
REPORT_LLM_MODEL=claude-sonnet-4-20250514

# Max tokens for AI-generated sections (500-4000 recommended)
REPORT_LLM_MAX_TOKENS=1500

# PDF page size: 'letter' or 'A4'
REPORT_PDF_PAGE_SIZE=letter

# ================================
# Application Settings
# ================================
LOG_LEVEL=INFO
ENVIRONMENT=development
